#!/bin/sh
# Brings the prototype's design in: app.js, style.css and the fonts copied as
# they are, index.html turned into the relevé's Twig template. The prototype
# (../observatoire-pq) stays where design work happens; this is the one way
# it reaches the application, so that the two never drift by hand.
#
# Each change below is checked: if the prototype moved and a pattern no
# longer matches, the sync stops rather than ship a page that half works.
set -eu
proto=${1:-../observatoire-pq}
site=$proto/site
here=$(cd "$(dirname "$0")/.." && pwd)
public=$here/public
template=$here/templates/releve/show.html.twig

for f in app.js style.css index.html fonts; do
    [ -e "$site/$f" ] || { echo "✗ $site/$f is missing" >&2; exit 1; }
done

fail() { echo "✗ $1" >&2; exit 1; }
count() { grep -c -F -- "$1" "$2" || true; }

# app.js: the data is no longer a script setting a global (data.js) but a
# JSON block in the page, which the CSP does not have to allow.
from="const D = window.OBSERVATOIRE;"
to="const D = JSON.parse(document.getElementById('donnees').textContent);"
[ "$(count "$from" "$site/app.js")" = 1 ] || fail "app.js: expected exactly one '$from'"
tmp=$(mktemp); trap 'rm -f "$tmp"' EXIT
awk -v from="$from" -v to="$to" '{ i = index($0, from); if (i) $0 = substr($0, 1, i - 1) to substr($0, i + length(from)); print }' "$site/app.js" > "$tmp"
[ "$(count "window.OBSERVATOIRE" "$tmp")" = 0 ] || fail "app.js still reads window.OBSERVATOIRE elsewhere"
cp "$tmp" "$public/app.js"
# mktemp made it private; the server runs as another user.
chmod 644 "$public/app.js"

cp "$site/style.css" "$public/style.css"
rm -rf "$public/fonts"
cp -R "$site/fonts" "$public/fonts"

# index.html → Twig. Anything Twig would read as its own syntax is refused
# rather than escaped: it has never happened, and should be looked at.
grep -q -E '\{\{|\{%|\{#' "$site/index.html" && fail "index.html contains Twig delimiters"
for marker in '<script src="data.js" defer></script>' '<script src="app.js" defer></script>' '<link rel="stylesheet" href="style.css">' '<title>Observatoire post-quantique</title>' '<meta name="description" content="' '<footer' '</footer>' '</head>'; do
    [ "$(count "$marker" "$site/index.html")" = 1 ] || fail "index.html: expected exactly one '$marker'"
done
mkdir -p "$(dirname "$template")"
{
    echo '{# Generated by bin/sync-prototype from observatoire-pq/site/index.html: edit the prototype, then `make sync`. #}'
    sed \
        -e 's#<script src="data.js" defer></script>#<script type="application/json" id="donnees">{{ donnees|raw }}</script>#' \
        -e 's#<script src="app.js" defer></script>#<script src="{{ versioned('"'"'/app.js'"'"') }}" defer></script>#' \
        -e 's#<link rel="stylesheet" href="style.css">#<link rel="stylesheet" href="{{ versioned('"'"'/style.css'"'"') }}">\
<link rel="stylesheet" href="{{ versioned('"'"'/site.css'"'"') }}">#' \
        -e 's#href="fonts/#href="/fonts/#g' \
        -e 's#^</head>#{{ include('"'"'releve/_head.html.twig'"'"') }}\
</head>#' \
        -e 's#<title>Observatoire post-quantique</title>#<title>{{ releve.title }} · Observatoire post-quantique</title>#' \
        -e 's#<meta name="description" content="[^"]*">#<meta name="description" content="{{ releve.intro }}">#' \
        -e 's#^<footer#{{ include('"'"'newsletter/_form.html.twig'"'"') }}\
\
<footer#' \
        -e 's#^</footer>#    <p><a href="{{ path('"'"'privacy'"'"') }}">Confidentialité et lettre d'"'"'information</a></p>\
</footer>#' \
        "$site/index.html"
} > "$template"
for marker in 'id="donnees"' "versioned('/app.js')" "versioned('/style.css')" 'releve.title' 'releve.intro' 'newsletter/_form.html.twig' "path('privacy')" 'releve/_head.html.twig'; do
    [ "$(count "$marker" "$template")" = 1 ] || fail "template: '$marker' was not inserted"
done

echo "✓ public/app.js, public/style.css, public/fonts/, templates/releve/show.html.twig <- $site"
