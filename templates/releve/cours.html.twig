{# Relevé 5, the course: no measurements, the same chapters as /comprendre,
   under the relevé's own sign, with its sharing link and newsletter form. #}
{% extends 'layout.html.twig' %}
{% block title %}{{ releve.title }}{% endblock %}
{% block robots %}{% endblock %}
{% block head %}
<meta name="description" content="{{ releve.intro }}">
{{ include('releve/_head.html.twig') }}
<script src="{{ versioned('/cours.js') }}" nonce="{{ csp_nonce() }}" defer></script>
{% endblock %}
{% block main_class %}cours{% endblock %}
{% block body %}
    {# The sign's date in French, Paris time, without the intl extension. #}
    {% set mois = ['janvier', 'février', 'mars', 'avril', 'mai', 'juin', 'juillet', 'août', 'septembre', 'octobre', 'novembre', 'décembre'] %}
    {% set le = releve.publishedAt|date('j', 'Europe/Paris') ~ ' ' ~ mois[releve.publishedAt|date('n', 'Europe/Paris') - 1] ~ ' ' ~ releve.publishedAt|date('Y', 'Europe/Paris') %}
    <p class="releve-cours">Relevé n° {{ releve.number }} · {{ le }}</p>
    <h1>L'école <em>du Q-Day</em></h1>
    <p class="chapo-cours">Depuis quatre relevés, on vous parle de TLS, de X25519MLKEM768, d'hybride et de Q-Day comme si c'était évident. Ça ne l'est pas. Ce relevé-ci ne mesure rien de nouveau : il explique, en neuf étapes courtes, ce que les autres mesurent. Pas besoin d'être ingénieur : si vous savez ce qu'est un cadenas, vous avez tout ce qu'il faut. Le cours reste en ligne, sans date, sous <a href="{{ path('course') }}">Comprendre</a>.</p>
    {{ include('cours/_chapitres.html.twig') }}
    {{ include('releve/_partage.html.twig') }}
    {{ include('newsletter/_form.html.twig') }}
{% endblock %}
