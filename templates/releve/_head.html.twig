{# What a search engine and a link preview read. Included in the relevé page by
   bin/sync-prototype, before </head>. Absolute URLs from SITE_URL: the address
   the public knows, whatever the proxy forwards. #}
{% set page_url = site_url ~ (is_home ? '/' : path('releve', {number: releve.number})) %}
{% set card = '/cards/releve-' ~ releve.number ~ '.png' %}
{% set title = 'Observatoire post-quantique · ' ~ releve.title %}
<link rel="canonical" href="{{ page_url }}">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<meta property="og:type" content="article">
<meta property="og:site_name" content="Observatoire post-quantique">
<meta property="og:locale" content="fr_FR">
<meta property="og:url" content="{{ page_url }}">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ releve.intro }}">
<meta property="og:image" content="{{ site_url ~ card }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{{ releve.title }} de l'observatoire post-quantique, publié le {{ releve.publishedAt|date('d/m/Y') }}">
<meta property="article:published_time" content="{{ releve.publishedAt|date('c') }}">
<meta property="article:author" content="https://www.linkedin.com/in/jeromenadaud">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ title }}">
<meta name="twitter:description" content="{{ releve.intro }}">
<meta name="twitter:image" content="{{ site_url ~ card }}">
<script type="application/ld+json">{{ {
    '@context': 'https://schema.org',
    '@type': 'Dataset',
    'name': title,
    'description': releve.intro,
    'url': page_url,
    'inLanguage': 'fr',
    'isAccessibleForFree': true,
    'datePublished': releve.publishedAt|date('Y-m-d'),
    'temporalCoverage': releve.date,
    'keywords': ['cryptographie post-quantique', 'TLS', 'ML-KEM', 'X25519MLKEM768', 'souveraineté numérique', 'France'],
    'creator': {'@type': 'Person', 'name': 'Jérôme Nadaud', 'sameAs': ['https://github.com/jnadaud', 'https://www.linkedin.com/in/jeromenadaud']},
    'publisher': {'@type': 'Organization', 'name': 'BlackMesa', 'url': 'https://mesa.black/'},
    'image': site_url ~ card,
}|json_encode(constant('JSON_UNESCAPED_UNICODE') b-or constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_HEX_TAG'))|raw }}</script>
