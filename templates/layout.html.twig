<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}{% endblock %} · Observatoire post-quantique</title>
<meta name="referrer" content="no-referrer">
{% block robots %}<meta name="robots" content="noindex">{% endblock %}
<link rel="stylesheet" href="{{ versioned('/style.css') }}">
<link rel="stylesheet" href="{{ versioned('/site.css') }}">
{% block head %}{% endblock %}
</head>
<body>
<main class="wrap {% block main_class %}court{% endblock %}">
    <p class="sur"><a href="{{ path('home') }}">Observatoire post-quantique</a></p>
    {% block body %}{% endblock %}
</main>
<footer class="wrap pied">
    <p>Un projet BlackMesa. Pas de cookie, pas de traceur, rien qui vienne d'ailleurs.</p>
    {# No link to the page one is on (the error page renders without a request). #}
    {% set here = app.request ? app.request.attributes.get('_route') : null %}
    {% set links = {course: 'Comprendre', privacy: 'Confidentialité'}|filter((label, route) => route != here) %}
    <p>{% for route, label in links %}{% if not loop.first %} · {% endif %}<a href="{{ path(route) }}">{{ label }}</a>{% endfor %}</p>
</footer>
</body>
</html>
