} %}<svg class="ico" viewBox="0 0 24 24" aria-hidden="true">{{ paths[name]|raw }}</svg>{% endmacro %}

{% macro statut(status) %}<span class="badge {{ status }}">{{ {draft: 'brouillon', scheduled: 'programmée', sending: 'en cours d\'envoi', sent: 'envoyée'}[status] }}</span>{% endmacro %}

{# The letter as the reader gets it: envelope, body, footer. #}
{% macro courriel(subject, html) %}
<aside class="carte serree courriel" aria-label="Aperçu de la lettre">
    <div class="enveloppe">
        <span>De</span><span>Observatoire post-quantique</span>
        <span>Objet</span><span class="objet" id="apercu-objet">{{ subject ?: 'Sans objet' }}</span>
    </div>
    <div class="lettre">
        <div id="apercu-corps">{% if html|trim %}{{ html|raw }}{% else %}<p class="attente">Le texte apparaît ici à mesure qu'il est écrit.</p>{% endif %}</div>
        <p class="pied">Observatoire post-quantique · BlackMesa<br>Ce message vous parvient parce que cette adresse est inscrite à la lettre de l'Observatoire. <a href="#">Se désinscrire</a>.</p>
    </div>
</aside>
{% endmacro %}
