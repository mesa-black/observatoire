{% extends 'layout.html.twig' %}
{% block title %}Comprendre{% endblock %}
{# Unlike the other small pages, this one is meant to be found. #}
{% block robots %}{% endblock %}
{% block head %}
<meta name="description" content="TLS, échange de clés, Q-Day, ML-KEM, hybride X25519MLKEM768 : ce que mesure l'Observatoire post-quantique, expliqué en neuf étapes, sans être ingénieur.">
<link rel="canonical" href="{{ site_url ~ path('course') }}">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<script src="{{ versioned('/cours.js') }}" nonce="{{ csp_nonce() }}" defer></script>
{% endblock %}
{% block main_class %}cours{% endblock %}
{% block body %}
    <h1>Comprendre <em>le Q-Day</em>, en neuf étapes</h1>
    <p class="chapo-cours">Les relevés parlent de TLS, de X25519MLKEM768, d'hybride et de Q-Day comme si c'était évident. Ça ne l'est pas. Voici ce qu'ils mesurent, expliqué pas à pas : si vous savez ce qu'est un cadenas, vous avez tout ce qu'il faut.</p>
    {{ include('cours/_chapitres.html.twig') }}
{% endblock %}
