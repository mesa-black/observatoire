# Defaults, committed. Real values come from the pod's environment (the Secret
# `observatoire`, see deploy/k3s/spoke/apps/observatoire/secret.example.yaml),
# which always wins over this file. Nothing secret here.

APP_ENV=dev
# Signs the links in the mails. Empty here on purpose: production must set
# it (Secret), and an empty one is refused (App\Newsletter\Tokens).
APP_SECRET=
# Absolute links in mails (confirmation, unsubscribe) are built from this.
SITE_URL=http://localhost:8080

# One file on the pod's volume. See README, "Why SQLite".
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data/observatoire.db"
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

# Brevo in production: brevo+api://xkeysib-…@default. null:// sends nothing.
MAILER_DSN=null://null
# The newsletter is off until a mail provider is chosen: no form on the
# pages, and /newsletter answers 404. 1 to turn it on (with a real MAILER_DSN).
NEWSLETTER_ENABLED=0
MAILER_FROM="Observatoire post-quantique <observatoire@mesa.black>"

# The one admin account. The hash comes from `bin/console security:hash-password`;
# empty means nobody can log in. The TOTP secret is optional (base32, from
# `bin/console app:admin:totp`); empty means password only.
ADMIN_EMAIL=admin@example.invalid
ADMIN_PASSWORD_HASH=
ADMIN_TOTP_SECRET=

# Traefik, in front, is in the pod network: its X-Forwarded-For is believed,
# nobody else's. Without it every visitor would share the proxy's address in
# the rate limiter.
TRUSTED_PROXIES=127.0.0.1,10.42.0.0/16

# The only Host headers answered; any other gets a 400. The pod network is
# there for the kubelet's probes, which name the pod by its address.
TRUSTED_HOSTS='^(localhost|127\.0\.0\.1|observatoire\.mesa\.black|10\.42\.\d{1,3}\.\d{1,3})$'
